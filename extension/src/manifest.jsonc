{
  "manifest_version": 2,
  "name": "tabruh",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "2697cb95-6fdc-47a5-b3bb-a1369863ad0b",
      // sessions.getTabValue/getWindowValue -> ff v57
      "strict_min_version": "57",
    },
  },
  "permissions": [
    "activeTab",
    "tabs",
    "tabHide",
    "history",
    "bookmarks",
    "webNavigation",
    "sidePanel",
    "<all_urls>",
    "menus",
    "sessions",
    "storage",
  ],
  "background": {
    "scripts": [ "background.js" ],
    "type": "module",
  },
  "sidebar_action": {
    "default_title": "Tabruh",
    "default_panel": "sidebar.html",
  },
  "browser_action": {
    "default_title": "Tabruh",
  },
}
